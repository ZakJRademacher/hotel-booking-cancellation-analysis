          <zone h="3197" id="19" type-v2="text" w="98041" x="0" y="85394">
            <formatted-text>
              <run bold="true" fontcolor="#147d80" fontname="Segoe UI" fontsize="10">WHAT THIS MEANS</run>
            </formatted-text>
            <zone-style>
              <format attr="border-color" value="#444444" />
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="padding" value="10" />
            </zone-style>
          </zone>
          <zone h="7463" id="20" type-v2="text" w="98041" x="0" y="88912">
            <formatted-text>
              <run bold="false" fontcolor="#203b43" fontname="Segoe UI" fontsize="12">Compare counts and rates together. Prioritize a confirmation-process trial, then measure results against a randomized comparison group.</run>
            </formatted-text>
            <zone-style>

            <column-instance column="[Year]" derivation="None" name="[none:Year:nk]" pivot="key" type="nominal" />
            <column-instance column="[Canceled Nights]" derivation="Sum" name="[sum:Canceled Nights:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[analysis].[none:View:nk]">
            <groupfilter function="member" level="[none:View:nk]" member="&quot;kpi&quot;" />
          </filter>
          <slices>
            <column>[analysis].[none:View:nk]</column>
            <column>[analysis].[none:Hotel:nk]</column>
            <column>[analysis].[none:Year:nk]</column>
            <column>[analysis].[none:Period:nk]</column>
            <column>[analysis].[none:Segment:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="axis">
            <format attr="font-family" value="Segoe UI" />
            <format attr="font-size" value="10" />
            <format attr="color" value="#647085" />
            <format attr="title" scope="cols" value="Cancellations" />
          </style-rule>
          <style-rule element="cell">
            <format attr="font-family" value="Segoe UI" />
            <format attr="font-size" value="11" />
            <format attr="color" value="#18304F" />
          </style-rule>
          <style-rule element="label">
            <format attr="font-family" value="Segoe UI" />
            <format attr="font-size" value="10" />

            </zone-style>
          </zone>
          <zone h="7463" id="20" type-v2="text" w="98041" x="0" y="88912">
            <formatted-text>
              <run bold="false" fontcolor="#18304f" fontname="Segoe UI" fontsize="12">Compare counts and rates together. Prioritize a confirmation-process trial, then measure results against a randomized comparison group.</run>
            </formatted-text>
            <zone-style>
              <format attr="border-color" value="#647085" />

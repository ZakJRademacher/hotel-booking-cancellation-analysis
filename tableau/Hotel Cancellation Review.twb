          <zone h="4200" id="9002" type-v2="text" w="11225" x="1530" y="10600">
            <formatted-text>
              <run bold="true" fontcolor="#ffffff" fontname="Segoe UI" fontsize="16">HOTEL</run>
            </formatted-text>
            <zone-style>
              <format attr="border-color" value="#444444" />
              <format attr="border-style" value="none" />

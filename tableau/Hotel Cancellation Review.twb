  <worksheets>
    <worksheet name="Canceled booked nights">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#18304f" fontname="Segoe UI" fontsize="14">Canceled booked nights</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Where should reservations test better confirmation?" name="analysis" />
          </datasources>
          <datasource-dependencies datasource="analysis">
            <column datatype="integer" default-format="n#,##0" name="[Canceled Nights]" role="measure" type="quantitative" />
            <column datatype="string" name="[Hotel]" role="dimension" type="nominal" />
            <column datatype="string" name="[Period]" role="dimension" type="nominal" />
            <column datatype="string" name="[Segment]" role="dimension" type="nominal" />

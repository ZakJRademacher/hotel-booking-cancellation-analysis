          <zone h="6183" id="3" type-v2="text" w="98041" x="0" y="3624">
            <formatted-text>
              <run bold="true" fontcolor="#203b43" fontname="Segoe UI" fontsize="28">Where should reservations test better confirmation?</run>
            </formatted-text>
            <zone-style>
              <format attr="border-color" value="#444444" />

          <zone h="3197" id="19" type-v2="text" w="98041" x="0" y="85394">
            <formatted-text>
              <run bold="true" fontcolor="#2454a8" fontname="Segoe UI" fontsize="10">WHAT THIS MEANS</run>
            </formatted-text>
            <zone-style>
              <format attr="border-color" value="#647085" />
